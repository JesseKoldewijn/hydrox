{
  "name": "hydrox",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=@hydrox/web --filter=@hydrox/api...",
    "dev": "yarn workspace @hydrox/api dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=@hydrox/web",
    "test:integration": "turbo run test:integration --filter=@hydrox/api",
    "db:generate": "yarn workspace @hydrox/db generate",
    "db:migrate": "yarn workspace @hydrox/db migrate",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml up -d --build",
    "probe:stack": "node scripts/probe-stack.mjs",
    "probe:stack:full": "node scripts/probe-stack.mjs --full",
    "test:stack": "bash scripts/test-stack.sh",
    "test:stack:infra": "bash scripts/test-stack.sh infra",
    "test:stack:full": "bash scripts/test-stack.sh full",
    "test:stack:prod": "bash scripts/test-stack.sh prod",
    "validate": "yarn lint && yarn typecheck && yarn test",
    "ci:local": "yarn validate && yarn test:integration && yarn probe:stack"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
